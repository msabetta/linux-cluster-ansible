global
    log         /dev/log local0
    log         /dev/log local1 notice
    chroot      /var/lib/haproxy
    pidfile     /var/run/haproxy.pid
    maxconn     4000
    user        haproxy
    group       haproxy
    daemon

    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256
    ssl-default-bind-options ssl-min-ver TLSv1.2

defaults
    mode                    http
    log                     global
    option                  httplog
    option                  dontlognull
    option forwardfor       except 127.0.0.0/8
    option                  redispatch
    retries                 3
    timeout http-request    10s
    timeout queue           1m
    timeout connect         10s
    timeout client          1m
    timeout server          1m
    timeout http-keep-alive 10s
    timeout check           10s
    maxconn                 3000

frontend https_front
    bind *:{{ haproxy_frontend_port }} ssl crt /etc/haproxy/certs/combined.pem
    mode http
    default_backend web_servers

backend web_servers
    balance {{ haproxy_backends.web.balance }}
    option {{ haproxy_backends.web.health_check }}
{% for server in haproxy_backends.web.servers %}
    server {{ server.name }} {{ server.host }}:{{ server.port }} check
{% endfor %}

listen stats
    bind *:{{ haproxy_stats_port }}
    mode http
    stats enable
    stats uri /
    stats realm HAProxy\ Statistics
    stats auth admin:{{ haproxy_stats_password | default('admin') }}